rules_version = '2';

// Deployed rules as of 2026-09-01, plus read access to nutrition/ (M2).
// The expired 30-day catch-all (request.time < 2026-10-01) is dropped: it no
// longer matches anything, so effective access to apl/ and users/ is unchanged.
//
// Not deployed yet. To deploy (after team review):
//   npx firebase-tools deploy --only firestore:rules --project wolfbyte-proj1
service cloud.firestore {
  match /databases/{database}/documents {

    // NC APL catalog: signed-in read, no client writes (scripts/import.js).
    match /apl/{upc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Nutrition per UPC (scripts/seed_nutrition.cjs): signed-in read only.
    match /nutrition/{upc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Each shopper's basket and balances.
    match /users/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }
  }
}
